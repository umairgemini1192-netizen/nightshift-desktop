{
  "$description": "Night-Shift Desktop design tokens (DTCG). Single source of truth. Tier 1 primitives -> tier 2 semantic -> tier 3 component. UI code may reference ONLY semantic or component tokens.",
  "primitive": {
    "color": {
      "void":     { "$type": "color", "$value": "#05070D" },
      "abyss":    { "$type": "color", "$value": "#0A0F1C" },
      "deep":     { "$type": "color", "$value": "#101729" },
      "slate-700":{ "$type": "color", "$value": "#1B2440" },
      "slate-500":{ "$type": "color", "$value": "#3A4668" },
      "slate-300":{ "$type": "color", "$value": "#8F9BBF" },
      "slate-100":{ "$type": "color", "$value": "#D6DDF2" },
      "white":    { "$type": "color", "$value": "#F5F8FF" },
      "cyan-400": { "$type": "color", "$value": "#00D4FF" },
      "cyan-300": { "$type": "color", "$value": "#5FE3FF" },
      "violet-400":{ "$type": "color", "$value": "#A78BFA" },
      "violet-300":{ "$type": "color", "$value": "#C4B5FD" },
      "green-400":{ "$type": "color", "$value": "#34F5A0" },
      "amber-400":{ "$type": "color", "$value": "#FFC145" },
      "red-400":  { "$type": "color", "$value": "#FF5C7A" },
      "light-bg": { "$type": "color", "$value": "#EEF2FB" },
      "light-surface": { "$type": "color", "$value": "#FFFFFF" },
      "light-ink":{ "$type": "color", "$value": "#0B1222" },
      "light-muted": { "$type": "color", "$value": "#4A5577" }
    },
    "space":  { "0": {"$type":"dimension","$value":"0px"}, "1": {"$type":"dimension","$value":"4px"}, "2": {"$type":"dimension","$value":"8px"}, "3": {"$type":"dimension","$value":"12px"}, "4": {"$type":"dimension","$value":"16px"}, "5": {"$type":"dimension","$value":"20px"}, "6": {"$type":"dimension","$value":"24px"}, "8": {"$type":"dimension","$value":"32px"}, "10": {"$type":"dimension","$value":"40px"}, "12": {"$type":"dimension","$value":"48px"}, "16": {"$type":"dimension","$value":"64px"} },
    "radius": { "sm": {"$type":"dimension","$value":"8px"}, "md": {"$type":"dimension","$value":"12px"}, "lg": {"$type":"dimension","$value":"18px"}, "xl": {"$type":"dimension","$value":"24px"}, "pill": {"$type":"dimension","$value":"999px"} },
    "font": {
      "sans": { "$type": "fontFamily", "$value": ["Inter Variable", "Segoe UI Variable", "Segoe UI", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono Variable", "Cascadia Mono", "Consolas", "monospace"] },
      "display": { "$type": "fontFamily", "$value": ["Space Grotesk Variable", "Inter Variable", "sans-serif"] }
    },
    "size": { "xs": {"$type":"dimension","$value":"12px"}, "sm": {"$type":"dimension","$value":"13px"}, "md": {"$type":"dimension","$value":"15px"}, "lg": {"$type":"dimension","$value":"18px"}, "xl": {"$type":"dimension","$value":"22px"}, "2xl": {"$type":"dimension","$value":"30px"}, "3xl": {"$type":"dimension","$value":"44px"} },
    "duration": { "instant": {"$type":"duration","$value":"90ms"}, "fast": {"$type":"duration","$value":"160ms"}, "base": {"$type":"duration","$value":"240ms"}, "slow": {"$type":"duration","$value":"420ms"}, "ambient": {"$type":"duration","$value":"12000ms"} },
    "easing": { "out": {"$type":"cubicBezier","$value":[0.16,1,0.3,1]}, "inOut": {"$type":"cubicBezier","$value":[0.65,0,0.35,1]} }
  },
  "semantic": {
    "dark": {
      "bg.canvas":        { "$value": "{primitive.color.void}" },
      "bg.base":          { "$value": "{primitive.color.abyss}" },
      "surface.glass":    { "$value": "rgba(16,23,41,0.62)" },
      "surface.glass-strong": { "$value": "rgba(16,23,41,0.86)" },
      "surface.raised":   { "$value": "{primitive.color.deep}" },
      "border.subtle":    { "$value": "rgba(143,155,191,0.14)" },
      "border.strong":    { "$value": "rgba(143,155,191,0.28)" },
      "border.glow":      { "$value": "rgba(0,212,255,0.45)" },
      "text.primary":     { "$value": "{primitive.color.white}" },
      "text.secondary":   { "$value": "{primitive.color.slate-100}" },
      "text.muted":       { "$value": "{primitive.color.slate-300}" },
      "accent.primary":   { "$value": "{primitive.color.cyan-400}" },
      "accent.primary-soft": { "$value": "rgba(0,212,255,0.14)" },
      "accent.secondary": { "$value": "{primitive.color.violet-400}" },
      "accent.secondary-soft": { "$value": "rgba(167,139,250,0.16)" },
      "status.success":   { "$value": "{primitive.color.green-400}" },
      "status.warning":   { "$value": "{primitive.color.amber-400}" },
      "status.danger":    { "$value": "{primitive.color.red-400}" },
      "status.info":      { "$value": "{primitive.color.cyan-300}" },
      "focus.ring":       { "$value": "{primitive.color.cyan-300}" },
      "aurora.a":         { "$value": "rgba(0,212,255,0.20)" },
      "aurora.b":         { "$value": "rgba(167,139,250,0.18)" },
      "aurora.c":         { "$value": "rgba(52,245,160,0.10)" }
    },
    "light": {
      "bg.canvas":        { "$value": "{primitive.color.light-bg}" },
      "bg.base":          { "$value": "{primitive.color.light-bg}" },
      "surface.glass":    { "$value": "rgba(255,255,255,0.72)" },
      "surface.glass-strong": { "$value": "rgba(255,255,255,0.92)" },
      "surface.raised":   { "$value": "{primitive.color.light-surface}" },
      "border.subtle":    { "$value": "rgba(11,18,34,0.10)" },
      "border.strong":    { "$value": "rgba(11,18,34,0.22)" },
      "border.glow":      { "$value": "rgba(0,140,190,0.45)" },
      "text.primary":     { "$value": "{primitive.color.light-ink}" },
      "text.secondary":   { "$value": "#1E2A47" },
      "text.muted":       { "$value": "{primitive.color.light-muted}" },
      "accent.primary":   { "$value": "#006A8E" },
      "accent.primary-soft": { "$value": "rgba(0,127,168,0.12)" },
      "accent.secondary": { "$value": "#6D4FD8" },
      "accent.secondary-soft": { "$value": "rgba(109,79,216,0.12)" },
      "status.success":   { "$value": "#0B7148" },
      "status.warning":   { "$value": "#8A5900" },
      "status.danger":    { "$value": "#C2264A" },
      "status.info":      { "$value": "#006A8E" },
      "focus.ring":       { "$value": "#006A8E" },
      "aurora.a":         { "$value": "rgba(0,127,168,0.10)" },
      "aurora.b":         { "$value": "rgba(109,79,216,0.08)" },
      "aurora.c":         { "$value": "rgba(15,138,90,0.06)" }
    }
  },
  "component": {
    "card":    { "radius": "{primitive.radius.lg}", "padding": "{primitive.space.6}", "blur": "18px" },
    "sidebar": { "width": "248px", "width-collapsed": "72px" },
    "topbar":  { "height": "52px" },
    "button":  { "height-sm": "32px", "height-md": "40px", "height-lg": "48px", "radius": "{primitive.radius.md}" },
    "ring":    { "size-hero": "168px", "stroke-hero": "10px" },
    "glow":    { "accent": "0 0 0 1px rgba(0,212,255,0.35), 0 0 24px rgba(0,212,255,0.25)", "danger": "0 0 0 1px rgba(255,92,122,0.4), 0 0 24px rgba(255,92,122,0.25)" }
  }
}
